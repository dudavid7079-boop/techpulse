TECHPULSE_RELEASE_MARKER=20260712-product-radar-v2
TECHPULSE_REQUIRE_PUBLIC_CHECK=false

TECHPULSE_UMAMI_SCRIPT_URL=https://analytics.globalpilot.attodigitalhk.com/script.js
